<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Booki" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/booki_primaria</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#E9DDFF</item>
        <item name="colorOnPrimaryContainer">@color/booki_primaria_escura</item>
        <item name="colorSecondary">@color/booki_secundaria</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">#FFE3BF</item>
        <item name="android:colorBackground">@color/booki_fundo</item>
        <item name="colorSurface">@color/booki_superficie</item>
        <item name="android:statusBarColor">@color/booki_primaria_escura</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Toolbar padrão usada em todas as telas -->
    <style name="Booki.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/booki_primaria</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">#E0D7F5</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="Booki.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/booki_texto</item>
    </style>
</resources>
